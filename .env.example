# ----- Database (Supabase) -----
# Project Settings -> API -> Project URL + service_role key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- Server -----
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed origins for browser CORS (frontend dev server).
# When the React frontend is served from the same Railway service, this can be empty.
CORS_ORIGINS=http://localhost:5173

# ----- Auth -----
# Random secret used to sign JWTs. Generate with: openssl rand -hex 64
JWT_SECRET=please-generate-a-long-random-string
JWT_EXPIRES_IN=12h

# ----- Pricing (TCGCSV) -----
# Comma-separated TCGCSV category ids to refresh nightly.
# 3 = Pokemon, 1 = Magic, 2 = Yu-Gi-Oh, 23 = One Piece.
# See https://tcgcsv.com/ for the full list.
TCGCSV_CATEGORIES=3,1,2,23

# Cron expression for the nightly refresh (default: 03:00 daily, server time).
TCGCSV_REFRESH_CRON=0 3 * * *

# ----- Payments (Stripe, optional in Phase 1) -----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# ----- Email / SMS (optional, Phase 2) -----
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
