# === Required Environment Variables for Railway ===
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

WARDEN_SECRET=<random-32-char-hex>
WARDEN_HMAC_SECRET=<random-32-char-hex>
WARDEN_RESOLVE_TOKEN=<random-32-char-hex>
WARDEN_ADMIN_EMAIL=sheridan@yourdomain.com
N8N_BASE_URL=https://your-railway-n8n-domain.railway.app
GEMINI_API_KEY=<from-google-ai-studio>
SUPABASE_URL=https://peggccsshifakrfuyowi.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key-from-supabase>

# n8n Runtime Config (set automatically by Dockerfile)
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_RUNNERS_INSECURE_MODE=true
